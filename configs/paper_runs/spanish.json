{
  "dataset": {
    "gold": "data/paper_runs/spanish/gold.tsv",
    "word_column": "word",
    "score_column": "score",
    "lowercase": true,
    "pos_filter": {
      "enabled": false,
      "pos_column": "Dom_Pos",
      "tags": [
        "Noun"
      ]
    }
  },
  "embeddings": {
    "mode": "single",
    "active_space": "es_space",
    "spaces": [
      {
        "id": "es_space",
        "kind": "ft_bin",
        "path": "embeddings/cc.es.300.bin",
        "label": "es_space"
      }
    ]
  },
  "model": {
    "kind": "knn"
  },
  "runtime": {
    "seed": 13,
    "n_jobs": -1,
    "output_dir": "data/generated_scores/paper_runs/spanish"
  },
  "prediction": {
    "test_size": 0.2,
    "cv_folds": 5,
    "k_min": 5,
    "k_max": 100,
    "k_step": 5,
    "topn_neighbors": 10,
    "target": "data/paper_runs/spanish/targets.txt"
  },
  "reports": {
    "level": "full"
  }
}
