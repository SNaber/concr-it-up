{
  "dataset": {
    "gold": "examples/smoke/gold.csv",
    "word_column": "word",
    "score_column": "score",
    "lowercase": true,
    "pos_filter": {
      "enabled": false,
      "pos_column": "pos",
      "tags": []
    }
  },
  "embeddings": {
    "mode": "single",
    "active_space": "synthetic_mini",
    "spaces": [
      {
        "id": "synthetic_mini",
        "kind": "vec",
        "path": "examples/smoke/mini.vec",
        "label": "synthetic_mini"
      }
    ]
  },
  "model": {
    "kind": "knn"
  },
  "runtime": {
    "output_dir": "data/generated_scores/smoke",
    "seed": 13,
    "n_jobs": 1
  },
  "prediction": {
    "test_size": 0.25,
    "cv_folds": 3,
    "k_min": 1,
    "k_max": 3,
    "k_step": 1,
    "topn_neighbors": 3,
    "target": "examples/smoke/target.txt",
    "holdout": "examples/smoke/holdout.csv",
    "predictions_csv": "data/generated_scores/smoke/vocab_predictions.csv",
    "prediction_column": "pred",
    "unmatched_csv": "data/generated_scores/smoke/holdout_unmatched.csv"
  },
  "reports": {
    "level": "full"
  }
}
