# Application settings for the single-VM deployment. Install as
# /etc/concr-it-up/concr-it-up.env with mode 0640. The secret placeholder is
# empty; set CONCRITUP_SECRET_KEY to a new random value of at least 32
# characters before starting either service.

CONCRITUP_REPO_ROOT=/opt/concr-it-up
CONCRITUP_HOSTED_MODE=true
CONCRITUP_ACCESS_MODE=authenticated
CONCRITUP_SECRET_KEY=
CONCRITUP_EMBEDDING_ALLOWLIST=/etc/concr-it-up/embedding-allowlist.json
CONCRITUP_SESSION_ROOT=/opt/concr-it-up/data/hosted_sessions
CONCRITUP_PAPER_CONFIG_ROOT=/opt/concr-it-up/configs/paper_runs
CONCRITUP_JOB_ROOT=/opt/concr-it-up/data/jobs
CONCRITUP_JOB_DB=/opt/concr-it-up/data/state/jobs.sqlite3
CONCRITUP_CORE_ENTRYPOINT=/opt/concr-it-up/.venv/bin/concreteness-knn-core

# One worker, bounded queue, 48-hour terminal-job retention, 48-hour inactivity
# retention for owner uploads/configurations, and admission shutdown when the
# attached filesystem reaches 80% usage.
CONCRITUP_WORKER_POLL_SECONDS=1.0
CONCRITUP_WORKER_LEASE_SECONDS=60
CONCRITUP_RETENTION_HOURS=48
CONCRITUP_CLEANUP_INTERVAL_SECONDS=300
CONCRITUP_GLOBAL_JOB_LIMIT=20
CONCRITUP_OWNER_JOB_LIMIT=1
CONCRITUP_STORAGE_STOP_PERCENT=80

# Keep numerical libraries from multiplying threads inside each queued job.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
BLIS_NUM_THREADS=1
SKLEARN_WORKING_MEMORY=256

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
