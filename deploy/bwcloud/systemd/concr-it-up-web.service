[Unit]
Description=KNN-ConcrItUp Gunicorn web service
After=network.target local-fs.target
Wants=concr-it-up-worker.service
RequiresMountsFor=/opt/concr-it-up/data /opt/concr-it-up/embeddings /opt/concr-it-up/configs/user
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=concritup
Group=concritup
WorkingDirectory=/opt/concr-it-up
EnvironmentFile=/etc/concr-it-up/concr-it-up.env
# Gunicorn access logging stays disabled so query strings are not duplicated in
# journald; Nginx writes the minimized request log.
ExecStart=/opt/concr-it-up/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --worker-class gthread --threads 4 --timeout 60 --graceful-timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --error-logfile - "apps.core_gui.app:create_app()"
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
UMask=0027

# Web processes validate requests and persist queue records without loading models.
CPUQuota=100%
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=256M
TasksMax=128
LimitNOFILE=4096

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/concr-it-up/embeddings
ReadWritePaths=/opt/concr-it-up/data /opt/concr-it-up/configs/user

[Install]
WantedBy=multi-user.target
